            "type": "grafana-amazonprometheus-datasource",
            "uid": "otboo-amp"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"otboo\",aws_ecs_task_family=\"otboo-backend\",aws_ecs_cluster_arn=\"arn:aws:ecs:ap-northeast-2:121246721746:cluster/otboo-dev-cluster\",uri!~\"/actuator.*\"}[5m]))",
