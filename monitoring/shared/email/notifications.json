{
  "apiVersion": 1,
  "contactPoints": [
    {
      "orgId": 1,
      "name": "otboo-personal-email",
      "receivers": [
        {
          "uid": "otboo-personal-email",
          "type": "email",
          "disableResolveMessage": false,
          "settings": {
            "addresses": "$OTBOO_ALERT_EMAIL",
            "singleEmail": true
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "otboo-personal-email",
      "group_by": ["grafana_folder", "alertname"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    }
  ]
}
