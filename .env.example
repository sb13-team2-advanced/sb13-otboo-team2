# 이 파일을 .env.dev로 복사한 뒤, 개인 로컬 환경에 맞게 값을 채웁니다.
# .env.dev에는 실제 비밀번호 같은 개인 설정이 들어가므로 Git에 올리지 않습니다.

OOTD_DB_HOST=localhost
OOTD_DB_PORT=5432
OOTD_DB_NAME=ootd
OOTD_DB_USERNAME=ootd
OOTD_DB_PASSWORD=ootd1234

OOTD_JPA_DDL_AUTO=validate
OOTD_JPA_FORMAT_SQL=true
OOTD_JPA_SHOW_SQL=false
OOTD_FLYWAY_ENABLED=true

# Docker Desktop 실행 후 앱을 시작하면 DB를 자동 실행합니다.
# 직접 설치한 DB나 원격 DB를 사용할 때는 false로 설정합니다.
OOTD_DOCKER_COMPOSE_ENABLED=true

OOTD_REDIS_HOST=localhost
OOTD_REDIS_PORT=6379