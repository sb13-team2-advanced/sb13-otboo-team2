# 이 파일을 .env.dev로 복사한 뒤, 개인 로컬 환경에 맞게 값을 채웁니다.
# .env.dev에는 실제 비밀번호 같은 개인 설정이 들어가므로 Git에 올리지 않습니다.

OOTD_DB_HOST=localhost
OOTD_DB_PORT=5432
OOTD_DB_NAME=ootd
OOTD_DB_USERNAME=ootd
OOTD_DB_PASSWORD=ootd1234

OOTD_JPA_DDL_AUTO=validate
OOTD_JPA_FORMAT_SQL=true
OOTD_JPA_SHOW_SQL=false
OOTD_FLYWAY_ENABLED=true

# Docker Desktop 실행 후 앱을 시작하면 DB를 자동 실행합니다.
# 직접 설치한 DB나 원격 DB를 사용할 때는 false로 설정합니다.
OOTD_DOCKER_COMPOSE_ENABLED=true

OOTD_REDIS_HOST=localhost
OOTD_REDIS_PORT=6379

# 외부 API 키. 각자 발급받아 .env.dev에만 넣고 절대 커밋하지 않습니다.
KAKAO_API_KEY=
OWM_API_KEY=

# JWT 서명 키. Base64로 인코딩된 32바이트 이상의 값이 필요합니다.
JWT_SECRET=

# 서버 시작 시 만들어지는 초기 관리자 계정. 비어 있으면 서버가 시작되지 않습니다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# S3 버킷 이름과 이미지를 제공하는 CloudFront 주소
OTBOO_STORAGE_S3_BUCKET=otboo-prod-images
OTBOO_STORAGE_S3_BASE_URL=https://d32h6socf0ryd3.cloudfront.net

# Kafka는 기본 비활성화합니다. 일반 로컬 개발에서는 false를 유지합니다.
# 실제 배포 환경 또는 로컬 Kafka 이벤트 발행 테스트 시에만 활성화 부탁드립니다.
# 배포: SPRING_PROFILES_ACTIVE=prod,kafka 및 OTBOO_KAFKA_ENABLED=true
# 개인 테스트: SPRING_PROFILES_ACTIVE=dev,kafka 및 OTBOO_KAFKA_ENABLED=true
# 활성화할 환경에 아래 Confluent Cloud 접속 정보를 별도로 설정합니다.
OTBOO_KAFKA_ENABLED=false

# Confluent Cloud의 Kafka 클러스터 접속 주소와 해당 클러스터용 API Key
CONFLUENT_BOOTSTRAP_SERVERS=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
OTBOO_NOTIFICATION_KAFKA_TOPIC=otboo.notification.requested.v1
OTBOO_NOTIFICATION_KAFKA_GROUP_ID=otboo-notifications-v1
